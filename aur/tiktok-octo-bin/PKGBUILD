# Maintainer: octo <octo@users.noreply.github.com>

pkgname=tiktok-octo-bin
_name=tiktok-octo
pkgver=1.1.0
pkgrel=1
pkgdesc='Неофициальный десктоп-клиент TikTok: официальный сайт в нативной оболочке Electron'
arch=('x86_64')
url='https://github.com/octomood/tiktok-octo'
license=('MIT')
depends=(
  'alsa-lib'
  'gtk3'
  'libcups'
  'libdrm'
  'libnotify'
  'libxkbcommon'
  'libxss'
  'libxtst'
  'mesa'
  'nss'
)
provides=('tiktok-octo')
conflicts=('tiktok-octo' 'tiktok-octo-git')
options=('!strip' '!debug')
source=("$pkgname-$pkgver.AppImage::https://github.com/octomood/tiktok-octo/releases/download/v$pkgver/tiktok-octo-$pkgver-linux-x86_64.AppImage")
sha256sums=('d469672c56f089300f8bb03bde4332813989c9e422e3668c8e17a95c7f043784')

package() {
  cd "$srcdir"

  # Распаковываем AppImage на этапе сборки: иначе пользователю нужен
  # libfuse2, а приложение всё равно лежит в /opt целиком.
  chmod +x "$pkgname-$pkgver.AppImage"
  ./"$pkgname-$pkgver.AppImage" --appimage-extract > /dev/null

  install -dm755 "$pkgdir/opt/$_name"
  cp -a squashfs-root/. "$pkgdir/opt/$_name/"

  # В образе часть каталогов приходит с правами 700 — чиним, чтобы файлы
  # читались обычным пользователем.
  chmod -R a+rX "$pkgdir/opt/$_name"

  # Chromium ищет SUID-хелпер песочницы: без него Electron не стартует
  # на системах, где обычным пользователям запрещены user namespaces.
  chown root:root "$pkgdir/opt/$_name/chrome-sandbox"
  chmod 4755 "$pkgdir/opt/$_name/chrome-sandbox"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$_name" << 'EOF'
#!/bin/sh
exec /opt/tiktok-octo/tiktok-octo "$@"
EOF

  install -Dm644 "$pkgdir/opt/$_name/usr/share/icons/hicolor/512x512/apps/$_name.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$_name.png"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$_name.desktop" << 'EOF'
[Desktop Entry]
Name=TikTok octo
Comment=Неофициальный десктоп-клиент TikTok
Exec=tiktok-octo %U
Terminal=false
Type=Application
Icon=tiktok-octo
StartupWMClass=tiktok-octo
Categories=Network;Video;
Keywords=tiktok;video;social;
MimeType=x-scheme-handler/tiktok-octo;
Actions=pip;messages;mute;

[Desktop Action pip]
Name=Картинка в картинке
Exec=tiktok-octo --pip

[Desktop Action messages]
Name=Сообщения
Exec=tiktok-octo --messages

[Desktop Action mute]
Name=Без звука
Exec=tiktok-octo --mute
EOF
}
