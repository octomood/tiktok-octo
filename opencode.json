{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "npm start*", "effect": "deny" },
    { "action": "shell", "resource": "npm run start*", "effect": "deny" },
    { "action": "shell", "resource": "npm run dev*", "effect": "deny" },
    { "action": "shell", "resource": "npx electron*", "effect": "deny" },
    { "action": "shell", "resource": "electron .*", "effect": "deny" },
    { "action": "shell", "resource": "./node_modules/.bin/electron*", "effect": "deny" },
    {
      "action": "shell",
      "resource": "/home/*/Projects/*/node_modules/.bin/electron*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "/home/*/Projects/*/node_modules/electron/dist/electron*",
      "effect": "deny"
    },
    { "action": "shell", "resource": "npm exec electron*", "effect": "deny" },
    { "action": "shell", "resource": "npx playwright test*", "effect": "deny" },
    { "action": "shell", "resource": "npx playwright open*", "effect": "deny" },
    { "action": "shell", "resource": "npx playwright codegen*", "effect": "deny" },
    { "action": "shell", "resource": "*node_modules/.bin/playwright*", "effect": "deny" },
    { "action": "shell", "resource": "*node_modules/@playwright/test/cli.js*", "effect": "deny" },
    { "action": "shell", "resource": "chromium*", "effect": "deny" },
    { "action": "shell", "resource": "chromium-browser*", "effect": "deny" },
    { "action": "shell", "resource": "google-chrome*", "effect": "deny" },
    { "action": "shell", "resource": "firefox*", "effect": "deny" },
    { "action": "shell", "resource": "brave*", "effect": "deny" },
    { "action": "shell", "resource": "vivaldi*", "effect": "deny" },
    { "action": "shell", "resource": "nohup *", "effect": "deny" },
    { "action": "shell", "resource": "setsid *", "effect": "deny" },
    { "action": "shell", "resource": "./dist/linux-unpacked/*", "effect": "deny" },
    { "action": "shell", "resource": "./dist/*.AppImage*", "effect": "deny" },
    { "action": "shell", "resource": "xdg-open*", "effect": "deny" },
    { "action": "shell", "resource": "gio open*", "effect": "deny" },
    { "action": "shell", "resource": "sensible-browser*", "effect": "deny" },
    { "action": "shell", "resource": "npm run release*", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git tag*", "effect": "ask" }
  ]
}
