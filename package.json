{
  "name": "tiktok-octo",
  "productName": "TikTok octo",
  "version": "0.2.0",
  "description": "Неофициальный десктоп-клиент TikTok: официальный веб-сайт в нативной оболочке Electron",
  "main": "src/main/main.js",
  "desktopName": "tiktok-octo.desktop",
  "author": {
    "name": "octo",
    "email": "octo@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/octomood/tiktok-octo.git"
  },
  "homepage": "https://github.com/octomood/tiktok-octo",
  "bugs": {
    "url": "https://github.com/octomood/tiktok-octo/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "app.octo.tiktok",
    "productName": "TikTok octo",
    "copyright": "TikTok octo. Неофициальный клиент, не связан с TikTok Ltd.",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "octomood",
        "repo": "tiktok-octo",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "synopsis": "TikTok в отдельном окне"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Камера нужна для записи и загрузки видео на сайте TikTok.",
        "NSMicrophoneUsageDescription": "Микрофон нужен для записи видео со звуком на сайте TikTok."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TikTok octo"
    }
  }
}
